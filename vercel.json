{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://pizzia-portfolio-api-production.up.railway.app/api/$1"
    },
    {
      "src": "/(.*\\.(png|jpe?g|svg|ico|json|css|js|woff2?|ttf|eot|webp|gif))$",
      "dest": "/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}